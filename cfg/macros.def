# Effective JTFRAME target contract for Escape Kids.
#
# This is the tracked declarative counterpart of
# rtl/esckids/jtframe_macros.vh.  The standalone Template_MiSTer shell remains
# the integration boundary; this file is not a second framework copy.

CORENAME=EscapeKids
GAMETOP=jtsimson_game_sdram

JTFRAME_MEMGEN
JTFRAME_HEADER=4
JTFRAME_CLK48
JTFRAME_MR_DDRLOAD
JTFRAME_STEREO
JTFRAME_COLORW=8
JTFRAME_PXLCLK=6
JTFRAME_WIDTH=320
JTFRAME_HEIGHT=240
JTFRAME_BUTTONS=3
JTFRAME_JOY_DURL
JTFRAME_JOY1_POS
JTFRAME_RATE=59.19

# Physical stream addresses.  The values are byte addresses in the MRA stream.
JTFRAME_BA1_START=0x080000
JTFRAME_BA0_LEN=32
PCM_START=0x0A0000
JTFRAME_BA2_START=0x1E0000
JTFRAME_BA3_START=0x2E0000
JTFRAME_PROM_START=0x6E0000
JTFRAME_IOCTL_RD=128
GAME_ROM_LEN=0x6E0000

JTFRAME_OSD_TEST
JTFRAME_NOMRA_DIP
JTFRAME_ARX=4
JTFRAME_ARY=3
JTFRAME_180SHIFT=0
JTFRAME_SHIFT=1
JTFRAME_LF_HW=9
JTFRAME_LF_VW=8
JTFRAME_MCLK=48000000
JTFRAME_TIMESTAMP=0
JTFRAME_MR_FASTIO=0
JTFRAME_DIALEMU_LEFT=5
JTFRAME_RELEASE
JTFRAME_DEBUG_VPOS=0
JTKCPU_DEBUG
